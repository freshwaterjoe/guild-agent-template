{
  "manifestVersion": 1,
  "slug": "my-specialist",
  "name": "My specialist",
  "version": "0.1.0",
  "summary": "One sentence a buyer reads first: the job this specialist does, and why it does it better than a general model.",
  "builder": {
    "name": "Guild studio"
  },
  "inputs": {
    "schema": {
      "type": "object",
      "properties": {
        "question": {
          "type": "string",
          "minLength": 10,
          "maxLength": 4000,
          "description": "What you want answered or produced, in your own words."
        },
        "audience": {
          "type": "string",
          "maxLength": 500,
          "description": "Who will read the result."
        },
        "notes": {
          "type": "string",
          "maxLength": 2000,
          "description": "Anything else: context, constraints, examples."
        }
      },
      "required": [
        "question"
      ]
    },
    "files": {
      "accept": [
        "text/plain",
        "text/markdown",
        "text/csv",
        "application/pdf"
      ],
      "maxCount": 5,
      "maxTotalBytes": 10000000
    }
  },
  "deliverables": [
    {
      "name": "report",
      "description": "The finished work, ready to use.",
      "contentTypes": [
        "text/markdown"
      ]
    }
  ],
  "pricing": {
    "currency": "USD",
    "tiers": [
      {
        "id": "standard",
        "name": "Standard (price not set yet)",
        "priceCents": 100
      }
    ]
  },
  "limits": {
    "budgetMicros": 3000000,
    "deadlineSeconds": 1800,
    "instance": "standard-1"
  },
  "models": [
    {
      "provider": "anthropic",
      "model": "claude-opus-5-5"
    }
  ],
  "network": {
    "hosts": []
  },
  "questions": {
    "allowed": true,
    "max": 1
  },
  "dataHandling": [
    {
      "id": "network-gateway-only",
      "statement": "The agent can reach models and tools only through Guild. All other network access is blocked.",
      "level": "enforced"
    },
    {
      "id": "fresh-environment-per-task",
      "statement": "Each task runs in a new, empty environment that is destroyed afterwards. Nothing carries over between tasks.",
      "level": "enforced"
    }
  ],
  "checks": [
    {
      "id": "required-outputs",
      "description": "Every deliverable is present and not empty."
    },
    {
      "id": "rubric-review",
      "description": "A separate reviewer checks the work against the specialist's rubric, and the agent revises until it passes."
    }
  ]
}
